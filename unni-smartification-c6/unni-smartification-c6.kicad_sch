  (text "USB data is represented as KiCad group buses. Nets use *_P/*_N naming so PCB Editor recognizes both sides of R20/R21 as differential pairs. Target USB FS differential impedance: 90 ohm; final width/gap depends on PCB stackup." (exclude_from_sim no) (at 300.00 178.00 0) (effects (font (size 1.0 1.0)) (justify left bottom)) (uuid "18d9b1eb-13e5-4d87-863b-058590e7e008"))
