B3V3IN SYS GND I={max(I(I1),0)*max(V(+3V3),0)/(0.88*max(V(SYS),1.8))}
R302 +BATT GND 330

.control
set wr_singlescale
tran 100u 1.2s
wrdata vbat_3.7V_rint_0.3ohm.csv time v(VBUS) v(+BATT) v(SYS) v(+3V3) v(+5V) v(UNNI_AC) v(BOOST_CMD) v(/USB_+_Power/BOOST_IN) i(V2)
