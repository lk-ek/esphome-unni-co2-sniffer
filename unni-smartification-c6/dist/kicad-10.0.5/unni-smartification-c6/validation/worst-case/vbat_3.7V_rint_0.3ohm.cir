R301 UNNI_AC GND 100
BBOOSTEXTRA /USB_+_Power/BOOST_IN GND I={min(max((0.30/max(V(/USB_+_Power/BOOST_IN),1.0)-V(/USB_+_Power/BOOST_IN)/56)*min(max(V(+5V)/4.5,0),1),0),1.0)}
V3 BOOST_CMD GND PULSE( 0 3.3 0.5 5m 5m 4.5 6.5 ) 
R300 Net-_R300-Pad1_ +BATT 0.300
XR310 Net-_R310-Pad1_ VBUS USB_HOTPLUG
V2 Net-_R300-Pad1_ GND DC 3.700 
V1 Net-_R310-Pad1_ GND PULSE( 0 5 3 20m 20m 3 20 ) 
