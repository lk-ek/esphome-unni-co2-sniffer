XD4 UNNI_AC +5V SS14_SUB
R7 Net-_Q2-G_ +BATT 1Meg
L2 /USB_+_Power/BOOST_IN Net-_U3-SW_ 2.2u
XQ4 VBUS GND Net-_Q3-G_ AO3400A
C7 /USB_+_Power/BOOST_IN GND 10u
XD3 UNNI_AC VBUS SS14_SUB
R12 CHARGE_STAT GND 220k
R52 TOUCH_TRIGGER GND 100k
R34 BAT_TEMP_EXCITE BAT_TEMP_ADC 10k
R41 CONN_SCL CO2_SCL 10k
C20 BAT_ADC GND 100n
R11 Net-_U1-STAT_ CHARGE_STAT 150k
C5 +3V3 GND 10u
C2 +BATT GND 4.7u
R5 VBUS Net-_Q1-G_ 100k
R30 +BATT BAT_ADC 1Meg
R23 /ESP32-C6_+_Auxiliary/USB_P USB_RAW_P 22
R33 USB_ADC GND 220k
XQ1 Net-_Q1-G_ SYS +BATT AO3401A
C1 VBUS GND 4.7u
R42 CONN_RT RT 10k
R51 BACKLIGHT_ADC GND 220k
XU2 +3V3 Net-_U2-L2_ GND Net-_U2-L1_ SYS SYS GND SYS GND +3V3 GND TPS63031
C21 BAT_TEMP_ADC GND 100n
C3 SYS GND 10u
C22 USB_ADC GND 100n
XQ10 TOUCH_TRIGGER GND Net-_Q10-D_ AO3400A
R6 GND Net-_Q1-G_ 1Meg
R22 /ESP32-C6_+_Auxiliary/USB_N USB_RAW_N 22
R40 CONN_SDA CO2_SDA 10k
C6 +3V3 GND 10u
R43 CONN_RH RH 10k
C4 SYS GND 100n
C10 +3V3 GND 10u
R20 +3V3 /ESP32-C6_+_Auxiliary/ESP_EN 10k
R31 BAT_ADC GND 1Meg
C11 +3V3 GND 100n
XD1 SYS VBUS SS14_SUB
R21 +3V3 /ESP32-C6_+_Auxiliary/BOOT_GPIO9 10k
XU1 Net-_U1-STAT_ GND +BATT VBUS Net-_U1-PROG_ MCP73831
L1 Net-_U2-L1_ Net-_U2-L2_ 2.2u
R50 CONN_LED+ BACKLIGHT_ADC 330k
R32 VBUS USB_ADC 220k
