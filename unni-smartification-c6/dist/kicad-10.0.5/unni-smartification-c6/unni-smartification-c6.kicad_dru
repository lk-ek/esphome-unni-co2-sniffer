(version 1)

# Conservative low-cost PCBWay baseline for a 4-layer, 1 oz outer / 1 oz inner board.
# PCBWay can manufacture 4/4 mil geometry, but recommends >=6 mil for economical standard
# fabrication. Zone objects normally use 0.25 mm clearance; this 0.20 mm hard floor
# prevents numeric-rounding false positives while remaining above the published minimum.
(rule "PCBWay zone hard minimum"
  (constraint clearance (min 0.20mm))
  (condition "(A.Type == 'Zone') || (B.Type == 'Zone')")
)

# PCBWay's 1 oz guidance for different-net drilled holes is 0.45 mm for plated
# component holes and 0.30 mm for vias. The project-wide hole-to-hole minimum is
# therefore 0.30 mm; this rule raises the component-pad case to 0.45 mm.
(rule "PCBWay drilled pad hole spacing"
  (constraint hole_to_hole (min 0.45mm))
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
)

# Preferred trace widths and vias are defined by netclasses in the project.
# Power/switch nets intentionally do NOT have a global hard minimum track width:
# short neck-downs at IC pads are allowed, then the router returns to the wider class.
(rule "USB routing"
  (constraint track_width (min 0.15mm) (opt 0.20mm) (max 0.30mm))
  (constraint diff_pair_gap (min 0.15mm) (opt 0.20mm))
  (condition "A.NetClass == 'USB'")
)

(rule "Signal hard minimum"
  (constraint track_width (min 0.15mm) (opt 0.20mm))
  (condition "A.NetClass == 'Signal'")
)

(rule "Sensitive hard minimum"
  (constraint track_width (min 0.15mm) (opt 0.20mm))
  (condition "A.NetClass == 'Sensitive'")
)
