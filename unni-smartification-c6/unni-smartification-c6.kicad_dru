(version 1)

# Conservative JLCPCB baseline.  Zone objects are normally configured for 0.25 mm
# clearance; this 0.20 mm hard floor avoids 0.2499 mm rounding false positives while
# still catching genuinely too-close copper.
(rule "JLCPCB zone hard minimum"
  (constraint clearance (min 0.20mm))
  (condition "(A.Type == 'Zone') || (B.Type == 'Zone')")
)

# Only rules that can be enforced without rejecting valid IC pad escapes live here.
# Preferred trace widths and vias are defined by the netclasses in the project file.
# Power/switch nets intentionally do NOT have a global hard minimum track width:
# short neck-downs at fine-pitch IC pads are required, after which the interactive
# router defaults to the wider netclass width.
(rule "USB routing"
  (constraint track_width (min 0.15mm) (opt 0.20mm) (max 0.30mm))
  (constraint diff_pair_gap (min 0.15mm) (opt 0.20mm))
  (condition "A.NetClass == 'USB'")
)

(rule "Signal hard minimum"
  (constraint track_width (min 0.15mm) (opt 0.20mm))
  (condition "A.NetClass == 'Signal'")
)

(rule "Sensitive hard minimum"
  (constraint track_width (min 0.15mm) (opt 0.20mm))
  (condition "A.NetClass == 'Sensitive'")
)
